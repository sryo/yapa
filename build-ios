#!/bin/sh
# Builds yapa's daemons for the iPhone SE (arm64, iOS 15) into build/ios, signed with ldid.
# Go links ios/arm64 only through cgo, so this needs Xcode's iPhoneOS SDK.
set -e
cd "$(dirname "$0")"
sdk=$(xcrun --sdk iphoneos --show-sdk-path)
export GOOS=ios GOARCH=arm64 CGO_ENABLED=1
export CC="$(xcrun --sdk iphoneos -f clang) -isysroot $sdk -arch arm64 -miphoneos-version-min=15.0"
mkdir -p build/ios
go build -trimpath -ldflags="-s -w" -o build/ios/yata ./cmd/yata
ldid -S build/ios/yata
ls -l build/ios
