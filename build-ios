#!/bin/sh
# Builds yapa's daemons for the iPhone SE (arm64, iOS 15) into build/ios, signed with ldid.
# Go links ios/arm64 only through cgo, so this needs Xcode's iPhoneOS SDK.
# Caddy and cloudflared are built from their own pinned sources, so their go.mod (and its replaces) applies.
set -e
cd "$(dirname "$0")"
caddy=github.com/caddyserver/caddy/v2@v2.11.7
cloudflared=github.com/cloudflare/cloudflared@2026.10.7
sdk=$(xcrun --sdk iphoneos --show-sdk-path)
export GOOS=ios GOARCH=arm64 CGO_ENABLED=1
export CC="$(xcrun --sdk iphoneos -f clang) -isysroot $sdk -arch arm64 -miphoneos-version-min=15.0"
out=$(pwd)/build/ios
mkdir -p "$out"
go build -trimpath -ldflags="-s -w" -o "$out/yata" ./cmd/yata

src() { GOOS= GOARCH= GOFLAGS=-mod=mod go mod download -json "$1" | sed -n 's/.*"Dir": "\(.*\)",/\1/p'; }
(cd "$(src $caddy)" && GOFLAGS=-mod=mod go build -trimpath -ldflags="-s -w" -o "$out/caddy" ./cmd/caddy)
(cd "$(src $cloudflared)" && GOFLAGS=-mod=mod go build -trimpath -ldflags="-s -w -X main.Version=${cloudflared#*@}" -o "$out/cloudflared" ./cmd/cloudflared)

for b in yata caddy cloudflared; do ldid -S "$out/$b"; done
ls -l "$out"
