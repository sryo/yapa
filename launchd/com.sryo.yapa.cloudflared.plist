<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sryo.yapa.cloudflared</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/libexec/yapa/cloudflared</string>
		<string>tunnel</string>
		<string>--no-autoupdate</string>
		<string>--metrics</string>
		<string>127.0.0.1:20241</string>
		<string>run</string>
		<string>--url</string>
		<string>http://127.0.0.1:8080</string>
		<string>--token-file</string>
		<string>/var/jb/etc/yapa/tunnel.token</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/yapa/cloudflared.log</string>
</dict>
</plist>
