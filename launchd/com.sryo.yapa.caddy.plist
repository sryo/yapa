<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sryo.yapa.caddy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/libexec/yapa/caddy</string>
		<string>run</string>
		<string>--config</string>
		<string>/var/jb/etc/yapa/Caddyfile</string>
		<string>--adapter</string>
		<string>caddyfile</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/var/jb/var/yapa/caddy</string>
		<key>XDG_DATA_HOME</key>
		<string>/var/jb/var/yapa/caddy</string>
		<key>XDG_CONFIG_HOME</key>
		<string>/var/jb/var/yapa/caddy</string>
	</dict>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/yapa/caddy.log</string>
</dict>
</plist>
