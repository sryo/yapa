<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sryo.yapa.yata</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/libexec/yapa/yapa-run</string>
		<string>64</string>
		<string>/var/jb/usr/libexec/yapa/yata</string>
