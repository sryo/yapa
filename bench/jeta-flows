def pick_says_where_it_went():
    """After a pick's Enter the pad says what che says became of it, and never Sent on less than che's word."""
    def pick(label, states, want):
        delivered[:] = states
        hook("UserPromptSubmit", "a", "alpha")
        wrap_up("a", "alpha", "Commit the work?", [label, "Not yet"])
        need(until(lambda s: option(s, label)), f"the actions for {label!r} never showed")
        since = len(asked)
        tap_option(label)
        notes, end = [], time.time() + 12
        while time.time() < end and not (notes and notes[-1].startswith(want[-1])):
            n = state()["note"]
            if n and (not notes or notes[-1] != n): notes.append(n)
            time.sleep(0.1)
        shown = [w for w in ("Pending:", "Sent:", "Copied:", "Not confirmed:") if any(n.startswith(w) for n in notes)]
        need(shown == want, f"{label}: the pad said {notes}, not {want}")
        asks = [a for a in asked[since:] if a[1].startswith("/sent")]
        first = next((i for i, n in enumerate(notes) if n.startswith("Sent:")), None)
        need(first is None or asks, f"{label}: the pad said Sent without asking che")
    pick("Ship alpha", ["sent"], ["Sent:"])
    pick("Copy alpha", ["copied"], ["Copied:"])
    pick("Queue alpha", ["pending", "pending", "sent"], ["Pending:", "Sent:"])
    pick("Ask alpha", [None], ["Not confirmed:"])


def pick_again_typed_once():
    """A pick whose answer never came is sent again under the same key, so che types it once; another pick has its own."""
    hook("UserPromptSubmit", "a", "alpha")
    wrap_up("a", "alpha", "Commit the work?", ["Answer lost", "Not yet"])
    need(until(lambda s: option(s, "Answer lost")), "the actions never showed")
    since = len(asked)
    tap_option("Answer lost")
    need(until(lambda s: "didn't answer" in s["note"], 14), f"the pad didn't say the Mac didn't answer: {state()['note']!r}")
    tap_option("Answer lost")
    need(until(lambda s: s["note"].startswith("Sent:"), 6), f"picked again, the pad didn't say Sent: {state()['note']!r}")
    key = lambda a: urllib.parse.parse_qs(urllib.parse.urlsplit(a[1]).query).get("key", [""])[0]
    keys = [key(a) for a in said("/say", since)]
    need(len(keys) == 2 and keys[0] and keys[0] == keys[1], f"the pick sent again didn't carry the first one's key: {keys}")
    tap_option("Not yet")
    time.sleep(0.5)
    keys = [key(a) for a in said("/say", since)]
    need(len(keys) == 3 and keys[2] and keys[2] != keys[0], f"another pick didn't get a key of its own: {keys}")


def put_away_actions():
    """Actions you don't want to answer now can be put away, and found again on their ant."""
    hook("UserPromptSubmit", "a", "alpha")
    wrap_up("a", "alpha", "Commit the work?", ["Yes, commit", "Not yet"])
    need(until(lambda s: option(s, "Not yet")), "the actions never showed")
    for _ in range(3):
        s = state()
        if bare(s): break
        drive("/tap", x=20, y=20)
    need(until(bare, 2), f"no way back to the bare screen from the actions: still {state()['mode']}")
    tap_ant("a")
    need(until(lambda s: option(s, "Not yet")), "tapping its ant didn't bring the actions back")


def two_with_actions():
    """Two sessions each offering actions: either can be answered, the other is still there after."""
    hook("UserPromptSubmit", "a", "alpha"); hook("UserPromptSubmit", "b", "beta")
    wrap_up("a", "alpha", "Commit alpha?", ["Commit alpha", "Leave alpha"])
    wrap_up("b", "beta", "Push beta?", ["Push beta", "Leave beta"])
    need(until(lambda s: option(s, "alpha") or option(s, "beta")), "neither session's actions showed")
    # Get to beta's, whichever is up first: a swipe moves between them.
    for _ in range(3):
        if option(state(), "Push beta"): break
        drive("/swipe", way="left")
    since = len(asked)
    tap_option("Push beta")
    time.sleep(0.5)
    need(any("session=b" in a[1] and "Push beta" in a[2] for a in said("/say", since)), "beta's pick didn't go to beta")
    hook("UserPromptSubmit", "b", "beta")  # beta took the answer
    need(until(lambda s: option(s, "Commit alpha"), 4), f"alpha's actions weren't there after beta's: {[p['text'] for p in state()['placed']]}")
    since = len(asked)
    tap_option("Commit alpha")
    time.sleep(0.5)
    need(any("session=a" in a[1] and "Commit alpha" in a[2] for a in said("/say", since)), f"alpha's pick didn't go to alpha: {said('/say', since)}")
    need(not said("/cancel", 0), "picking the second stopped the first one's Enter")
    hook("UserPromptSubmit", "a", "alpha")
    need(until(bare, 4), f"text stayed up with nothing left to answer: {state()['mode']}")


def pick_while_one_waits():
    """A pick while another's Enter is still to come is Copied, never typed into it, and a tap still stops that Enter."""
    global enter_wait
    enter_wait = 8
    try:
        hook("UserPromptSubmit", "a", "alpha"); hook("UserPromptSubmit", "b", "beta")
        wrap_up("a", "alpha", "Commit alpha?", ["Commit alpha", "Leave alpha"])
        wrap_up("b", "beta", "Push beta?", ["Push beta", "Leave beta"])
        need(until(lambda s: option(s, "alpha") or option(s, "beta")), "neither session's actions showed")
        for _ in range(3):
            if option(state(), "Push beta"): break
            drive("/swipe", way="left")
        since = len(asked)
        tap_option("Push beta")
        hook("UserPromptSubmit", "b", "beta")
        need(until(lambda s: option(s, "Commit alpha"), 4), f"alpha's actions weren't there after beta's: {[p['text'] for p in state()['placed']]}")
        tap_option("Commit alpha")
        need(until(lambda s: (s["note"] or "").startswith("Copied: Commit alpha"), 2),
             f"alpha's pick, made while beta's Enter waited, wasn't said Copied: {state()['note']}")
        need(not said("/cancel", since), "picking the second stopped the first one's Enter")
        drive("/tap", x=20, y=20)
        time.sleep(0.4)
        need(said("/cancel", since), "after a copied pick, a tap didn't stop the first one's pending Enter")
    finally:
        enter_wait = 2


def awake_while_waiting():
    """Long after their turns end, an ant whose actions are still up stays awake; one with nothing left curls up."""
    for sid, folder in (("a", "alpha"), ("b", "beta")): hook("UserPromptSubmit", sid, folder)
    wrap_up("a", "alpha", "Commit alpha?", ["Commit alpha", "Leave alpha"])
    for sid, folder in (("a", "alpha"), ("b", "beta")): hook("Stop", sid, folder, last_assistant_message="done")
    # Put the actions away into their ant, so every ant is back at its spot.
    need(until(lambda s: option(s, "Leave alpha")), "the actions never showed")
    for _ in range(3):
        if bare(state()): break
        drive("/tap", x=20, y=20)
    need(until(bare, 2), f"the actions wouldn't go away: {state()['mode']}")
    time.sleep(110)
    acts = {k: v["act"] for k, v in state()["ants"].items()}
    need(acts.get("a") not in (None, "sleep"), f"alpha curled up with its actions still up: {acts}")
    need(acts.get("b") == "sleep", f"beta, with nothing left, didn't curl up: {acts}")


def ant_by_actions():
    """Side-by-side actions, centred under where the ant was: its ant stands over them, on the screen, alone or
    with another session, and again once they're put away and a tap on the ant brings them back."""
    for n in (1, 2):
        launch()
        sids = [("a", "alpha"), ("b", "beta")][:n]
        for sid, f in sids: hook("UserPromptSubmit", sid, f)
        wrap_up("a", "alpha", "Commit alpha?", ["Commit alpha", "Leave alpha"])
        for sid, f in sids: hook("Stop", sid, f, last_assistant_message="done")
        need(until(lambda s: option(s, "Leave alpha")), "the actions never showed")
        s = until(lambda s: ant(s, "a")["act"] == "aside" and near_text(s, "a"), 6)
        need(s, f"with {n} session(s), the ant didn't stand by its actions: {ant(state(), 'a')} {first_line(state())}")
        for _ in range(3):
            if bare(state()): break
            drive("/tap", x=20, y=20)
        need(until(bare, 2), "the actions wouldn't go away")
        # Put away, its ant comes closer, as if to the camera, while the other stays as it is.
        s = until(lambda s: ant(s, "a")["act"] in ("rest", "done") and ant(s, "a")["scale"] > 1.2, 12)
        need(s, f"with {n} session(s), the ant with actions waiting didn't come closer: {ant(state(), 'a')}")
        need(n == 1 or ant(s, "b")["scale"] < 1.05, f"the ant with nothing waiting came closer too: {ant(s, 'b')}")
        tap_ant("a")
        s = until(lambda s: option(s, "Leave alpha") and ant(s, "a")["act"] == "aside" and near_text(s, "a"), 6)
        need(s, f"with {n} session(s), brought back, the ant didn't stand by its actions: {ant(state(), 'a')} {first_line(state())}")


def tap_out_of_reply():
    """With another session's actions put away, a reply opens beside its ant, and tapping out of it goes back to the
    ants, not to the other session's actions; a question's ant stands beside its text too."""
    hook("UserPromptSubmit", "a", "alpha"); hook("UserPromptSubmit", "b", "beta")
    hook("Stop", "a", "alpha", last_assistant_message="Alpha is finished and tested.")
    wrap_up("b", "beta", "Push beta?", ["Push beta", "Leave beta"])
    need(until(lambda s: option(s, "Push beta")), "beta's actions never showed")
    s = until(lambda s: ant(s, "b")["act"] == "aside" and near_text(s, "b"), 6)
    need(s, f"beta's ant didn't stand beside its question: {ant(state(), 'b')} {first_line(state())}")
    for _ in range(3):
        if bare(state()): break
        drive("/tap", x=20, y=20)
    need(until(bare, 2), "beta's actions wouldn't go away")
    time.sleep(6)
    tap_ant("a")
    need(until(lambda s: s["mode"] == "reply"), "tapping alpha didn't open its reply")
    s = until(lambda s: ant(s, "a")["act"] == "aside" and near_text(s, "a"), 6)
    need(s, f"alpha's ant didn't stand beside its reply: {ant(state(), 'a')} {first_line(state())}")
    drive("/tap", x=400, y=250)
    time.sleep(1)
    s = state()
    need(bare(s), f"tapping out of alpha's reply opened {s['mode']} of {s.get('asker')}")


def first_line(s):
    return min(s["placed"], key=lambda p: p["y"]) if s["placed"] else None


def near_text(s, sid):
    """The ant is on the screen and within about 60 pt of the words of the text's first line (a centred line's
    words, not its frame, which spans the screen)."""
    a, l = ant(s, sid), first_line(s)
    if not l or not on_screen(s, a): return False
    x0 = l["x"] if l["left"] else l["x"] + (l["w"] - l["words"]) / 2
    dx = max(x0 - a["x"], 0, a["x"] - (x0 + l["words"])); dy = max(l["y"] - a["y"], 0, a["y"] - (l["y"] + l["h"]))
    return (dx * dx + dy * dy) ** 0.5 < 60


def on_screen(s, a):
    """The ant's whole body is on the screen, 20 pt in from each edge."""
    w, h = s["size"]
    return 20 <= a["x"] <= w - 20 and 20 <= a["y"] <= h - 20


