    drive("/twist", steps=1)
    need(until(lambda s: s["dial"]["path"] == ["server"]), "server didn't open")
    drive("/twist", steps=-1)  # back to back, let go
    need(until(lambda s: s["dial"]["open"] and s["dial"]["path"] == [] and s["dial"]["current"] == "server"),
         f"letting go on back didn't go up a level, on server: {state()['dial']}")
    drive("/tap")
    need(until(lambda s: not s["dial"]["open"], 2), "a tap didn't put the dial away")


