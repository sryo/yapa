#!/usr/bin/env python3
"""Measures goal 2 and 3 the way a person meets them: every flow the pad offers, run end to end in a booted
Simulator, from the hook or line that starts it, through the taps, swipes, holds and twists a hand would make, to
what reaches the session (the hook's answer, or what che was asked to type) and the screen it leaves. A flow counts
only if all of that happened. The pad runs with `-drive` (App/Drive.swift), which takes those gestures over HTTP on
this Mac and says what's on the screen; che and yata are stand-ins here, so nothing is typed into a real session.
Prints the path of a K1 run file; `-v` also says what each flow did.
"""
import json, math, os, subprocess, sys, threading, time, urllib.parse, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DRIVE, STUB, HOOKS = 8091, 8095, 8079
BUNDLE = "com.sryo.yapa"
VERBOSE = "-v" in sys.argv

# The stand-ins for che and yata: they remember what they were asked and answer as the real ones do.
asked = []
# What the stand-in che says became of each delivery it's asked about with /sent, in turn: a word for /sent's
# `state`, or None for an answer without one (a che that doesn't know). Once they run out, every delivery was sent.
delivered = []
# Like che, the stand-in types one delivery at a time: until the last typed one's Enter is due (or cancelled), text
# goes to the clipboard, answered with no Enter to wait for.
enter_wait, box_until = 2, 0.0
parts = {"parts": [{"name": "yata", "kind": "core", "on": True, "up": True, "watched": True},
                   {"name": "web", "kind": "site", "on": True, "up": True, "watched": True}],
         "disk_free_mb": 4000, "logs_mb": 3}


class Stub(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def answer(self, o):
        b = json.dumps(o).encode()
        self.send_response(200); self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)

    def do_GET(self):
        asked.append(("GET", self.path, ""))
        if self.path.startswith("/sent"):
            st = delivered.pop(0) if delivered else "sent"
            return self.answer({} if st is None else {"state": st, "sent": {"sent": True, "copied": False}.get(st)})
        self.answer(parts if self.path.startswith("/parts") else {"sessions": {}})

    def do_POST(self):
        global box_until
        body = self.rfile.read(int(self.headers.get("Content-Length") or 0)).decode("utf-8", "replace")
        asked.append(("POST", self.path, body))
        p = self.path
        if p.startswith("/talk"): self.answer({"text": "words from the pad", "enter_in": 0 if "dry" in p else 2, "lang": "en"})
        elif p.startswith("/say"):
            # Like che, it types a pick once: one sent again under the same key is answered with what became of it.
            key = urllib.parse.parse_qs(urllib.parse.urlsplit(p).query).get("key", [None])[0]
            again = key and any(f"key={key}" in a[1] for a in asked[:-1])
            if again: return self.answer({"text": body, "enter_in": 0, "again": True, "id": len(asked)})
            # Its answer to a pick that says so never arrives, though it typed it.
            if "lost" in body: return time.sleep(11)
            wait = 0 if time.time() < box_until else enter_wait
            if wait and "dry" not in p: box_until = time.time() + wait
            self.answer({"text": body, "enter_in": wait, **({"id": len(asked)} if "session=" in p else {})})
        elif p.startswith("/new"): self.answer({"folder": body, "url": "claude://code/new"})
        elif p.startswith("/cancel"):
            box_until = 0.0
            self.answer({"cancelled": True})
        elif p.startswith("/parts/"): self.answer(parts)
        else: self.answer({})


def sim(*a, check=True):
    return subprocess.run(["xcrun", "simctl", *a], capture_output=True, text=True, check=check).stdout


def drive(path, **o):
    r = urllib.request.Request(f"http://127.0.0.1:{DRIVE}{path}", data=json.dumps(o).encode() if o or path != "/state" else None)
    with urllib.request.urlopen(r, timeout=30) as f:
        return json.load(f)


def state(): return drive("/state")


def hook(event, sid, folder, wait=2, **more):
    e = {"hook_event_name": event, "session_id": sid, "cwd": "/Users/x/" + folder, **more}
    r = urllib.request.Request(f"http://127.0.0.1:{HOOKS}/hook", data=json.dumps(e).encode())
    try:
        with urllib.request.urlopen(r, timeout=wait) as f:
            b = f.read().decode()
            return json.loads(b) if b.strip() else {}
    except Exception as x:
        return {"error": str(x)}


def held(event, sid, folder, **more):
    """A hook that waits for the pad (a permission request): runs in the background, its answer in .result."""
    t = threading.Thread(target=lambda: setattr(t, "result", hook(event, sid, folder, wait=40, **more)), daemon=True)
    t.result = None
    t.start()
    return t


def until(f, secs=6):
    end = time.time() + secs
    while time.time() < end:
        s = state()
        if f(s): return s
        time.sleep(0.15)
    return None


def option(s, text):
    return next((p for p in s["placed"] if p["style"] in ("option", "suggestion") and text in p["text"]), None)


def tap_option(text, s=None):
    s = s or state()
    o = option(s, text)
    if not o: raise Fail(f"no option {text!r} on the screen: {[p['text'] for p in s['placed']]}")
    return drive("/tap", x=o["x"] + o["w"] / 2, y=o["y"] + o["h"] / 2)


def ant(s, sid): return s["ants"].get(sid) or (s["ants"].get("face") if s["single"] else None)


def tap_ant(sid):
    a = ant(state(), sid)
    if not a: raise Fail(f"no ant for {sid}")
    return drive("/tap", x=a["x"], y=a["y"])


def decision(t, secs=6):
    t.join(secs)
    d = (t.result or {}).get("hookSpecificOutput", {}).get("decision")
    if d is None: raise Fail(f"the hook got no decision: {t.result}")
    return d


def said(path, since):
    return [a for a in asked[since:] if a[1].startswith(path)]


class Fail(Exception): pass


def need(ok, why):
    if not ok: raise Fail(why)


def wrap_up(sid, folder, ask, labels):
    hook("PreToolUse", sid, folder, tool_name="mcp__ccd_turn__wrap_up",
         tool_input={"recap": "done", "ask": ask, "actions": [{"label": l} for l in labels]})


def bare(s): return s["mode"] == "face"


# The flows. Each starts on a fresh pad and raises Fail with what went wrong.
def permission(pick, check, words=False, suggestions=False):
    def flow():
        more = {"permission_suggestions": [{"type": "addRules", "rules": [{"toolName": "Bash"}], "behavior": "allow",
                                            "destination": "session"}]} if suggestions else {}
        hook("UserPromptSubmit", "a", "alpha")
        t = held("PermissionRequest", "a", "alpha", tool_name="Bash", tool_input={"command": "git push"}, **more)
        need(until(lambda s: s["asking"] and option(s, "Deny")), "the request never showed its buttons")
        since = len(asked)
        if words: drive("/hold", **{"for": 1.0})
        else: tap_option(pick)
        d = decision(t)
        check(d, since)
        need(until(lambda s: not s["asking"]), "the request stayed up after its answer")
    return flow


def allow_check(d, _): need(d.get("behavior") == "allow" and not d.get("updatedPermissions"), f"Allow: {d}")
def session_check(d, _):
    need(d.get("behavior") == "allow" and any(u.get("destination") == "session" for u in d.get("updatedPermissions", [])), f"This session: {d}")
def deny_check(d, _): need(d.get("behavior") == "deny" and not d.get("interrupt"), f"Deny: {d}")
def stop_check(d, _): need(d.get("behavior") == "deny" and d.get("interrupt") is True, f"Stop: {d}")
def words_check(d, since):
    need(d.get("behavior") == "deny" and "words from the pad" in d.get("message", ""), f"held to deny: {d}")
    need(said("/talk?dry", since), "the words weren't heard dry, so they may have been typed")


def long_request():
    """A request too long for one screen is read to its last word, page by page, its buttons on every page."""
    parts = [f"part{i}" for i in range(1, 301)] + ["x" * 120, "the-very-end"]
    hook("UserPromptSubmit", "a", "alpha")
    t = held("PermissionRequest", "a", "alpha", tool_name="Bash", tool_input={"command": " ".join(parts)})
    need(until(lambda s: s["asking"] and option(s, "Deny")), "the request never showed its buttons")
    drive("/tap")
    s = until(lambda s: s["mode"] == "detail" and s["pages"] and s["pages"][1] > 1)
    need(s, f"the request's detail didn't open in pages: {state()['pages']}")
    read = []
    for page in range(s["pages"][1]):
        s = until(lambda s: s["pages"][0] == page, 3)
        need(s, f"a drag up didn't turn to page {page + 1}: {state()['pages']}")
        need(option(s, "Allow") and option(s, "Deny"), f"page {page + 1} lost its buttons")
        read += [p["text"] for p in s["placed"] if p["style"] == "body" and p["text"] not in read]
        drive("/drag", dy=-150, speed=0)
    text = " ".join(read)
    missing = [p for p in parts[:300] + parts[301:] if p not in text.split()]
    need(not missing and "x" * 120 in text.replace(" ", ""), f"read to the end, the request lacked {missing[:5]} of {len(parts)} words")
    need(not any("…" in r for r in read), f"a line of the request was cut: {[r for r in read if '…' in r][:2]}")
    tap_option("Allow")
    allow_check(decision(t), 0)


def ask_question():
    hook("UserPromptSubmit", "a", "alpha")
    q = {"question": "Which colour?", "header": "Colour", "multiSelect": False, "options": [{"label": "red"}, {"label": "blue"}]}
    t = held("PermissionRequest", "a", "alpha", tool_name="AskUserQuestion", tool_input={"questions": [q]})
    need(until(lambda s: option(s, "blue")), "the question's options never showed")
    tap_option("blue")
    d = decision(t)
    need("blue" in json.dumps(d), f"the answer didn't carry blue: {d}")
    need(until(lambda s: not s["asking"]), "the question stayed up after its answer")


