def put_away_actions():
    """Actions you don't want to answer now can be put away, and found again on their ant."""
    hook("UserPromptSubmit", "a", "alpha")
    wrap_up("a", "alpha", "Commit the work?", ["Yes, commit", "Not yet"])
    need(until(lambda s: option(s, "Not yet")), "the actions never showed")
    for _ in range(3):
        s = state()
        if bare(s): break
        drive("/tap", x=20, y=20)
    need(until(bare, 2), f"no way back to the bare screen from the actions: still {state()['mode']}")
    tap_ant("a")
    need(until(lambda s: option(s, "Not yet")), "tapping its ant didn't bring the actions back")


def two_with_actions():
    """Two sessions each offering actions: either can be answered, the other is still there after."""
    hook("UserPromptSubmit", "a", "alpha"); hook("UserPromptSubmit", "b", "beta")
    wrap_up("a", "alpha", "Commit alpha?", ["Commit alpha", "Leave alpha"])
    wrap_up("b", "beta", "Push beta?", ["Push beta", "Leave beta"])
    need(until(lambda s: option(s, "alpha") or option(s, "beta")), "neither session's actions showed")
    # Get to beta's, whichever is up first: a swipe moves between them.
    for _ in range(3):
        if option(state(), "Push beta"): break
        drive("/swipe", way="left")
    since = len(asked)
    tap_option("Push beta")
    time.sleep(0.5)
    need(any("session=b" in a[1] and "Push beta" in a[2] for a in said("/say", since)), "beta's pick didn't go to beta")
    hook("UserPromptSubmit", "b", "beta")  # beta took the answer
    need(until(lambda s: option(s, "Commit alpha"), 4), f"alpha's actions weren't there after beta's: {[p['text'] for p in state()['placed']]}")
    since = len(asked)
    tap_option("Commit alpha")
    time.sleep(0.5)
    need(any("session=a" in a[1] and "Commit alpha" in a[2] for a in said("/say", since)), f"alpha's pick didn't go to alpha: {said('/say', since)}")
    need(not said("/cancel", 0), "picking the second stopped the first one's Enter")
    hook("UserPromptSubmit", "a", "alpha")
    need(until(bare, 4), f"text stayed up with nothing left to answer: {state()['mode']}")


def awake_while_waiting():
    """Long after their turns end, an ant whose actions are still up stays awake; one with nothing left curls up."""
    for sid, folder in (("a", "alpha"), ("b", "beta")): hook("UserPromptSubmit", sid, folder)
    wrap_up("a", "alpha", "Commit alpha?", ["Commit alpha", "Leave alpha"])
    for sid, folder in (("a", "alpha"), ("b", "beta")): hook("Stop", sid, folder, last_assistant_message="done")
    # Put the actions away into their ant, so every ant is back at its spot.
    need(until(lambda s: option(s, "Leave alpha")), "the actions never showed")
    for _ in range(3):
        if bare(state()): break
        drive("/tap", x=20, y=20)
    need(until(bare, 2), f"the actions wouldn't go away: {state()['mode']}")
    time.sleep(110)
    acts = {k: v["act"] for k, v in state()["ants"].items()}
    need(acts.get("a") not in (None, "sleep"), f"alpha curled up with its actions still up: {acts}")
    need(acts.get("b") == "sleep", f"beta, with nothing left, didn't curl up: {acts}")


def tap_out_of_reply():
    """With another session's actions put away, a reply opens beside its ant, and tapping out of it goes back to the
    ants, not to the other session's actions; a question's ant stands beside its text too."""
    hook("UserPromptSubmit", "a", "alpha"); hook("UserPromptSubmit", "b", "beta")
    hook("Stop", "a", "alpha", last_assistant_message="Alpha is finished and tested.")
    wrap_up("b", "beta", "Push beta?", ["Push beta", "Leave beta"])
    need(until(lambda s: option(s, "Push beta")), "beta's actions never showed")
    s = until(lambda s: ant(s, "b")["act"] == "aside" and near_text(s, "b"), 6)
    need(s, f"beta's ant didn't stand beside its question: {ant(state(), 'b')} {first_line(state())}")
    for _ in range(3):
        if bare(state()): break
        drive("/tap", x=20, y=20)
    need(until(bare, 2), "beta's actions wouldn't go away")
    time.sleep(6)
    tap_ant("a")
    need(until(lambda s: s["mode"] == "reply"), "tapping alpha didn't open its reply")
    s = until(lambda s: ant(s, "a")["act"] == "aside" and near_text(s, "a"), 6)
    need(s, f"alpha's ant didn't stand beside its reply: {ant(state(), 'a')} {first_line(state())}")
    drive("/tap", x=400, y=250)
    time.sleep(1)
    s = state()
    need(bare(s), f"tapping out of alpha's reply opened {s['mode']} of {s.get('asker')}")


def first_line(s):
    return min(s["placed"], key=lambda p: p["y"]) if s["placed"] else None


def near_text(s, sid):
    """The ant is within about 60 pt of the text's first line."""
    a, l = ant(s, sid), first_line(s)
    if not l: return False
    dx = max(l["x"] - a["x"], 0, a["x"] - (l["x"] + l["w"])); dy = max(l["y"] - a["y"], 0, a["y"] - (l["y"] + l["h"]))
    return (dx * dx + dy * dy) ** 0.5 < 60


