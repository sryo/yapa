def carried(s, dx):
    """Every line on the screen sits `dx` points sideways of its place, give or take the drift."""
    return s["shown"] and all(abs(l["cx"] - l["home"] - dx) < 2 for l in s["shown"])


def text_follows_finger():
    hook("UserPromptSubmit", "a", "alpha"); hook("UserPromptSubmit", "b", "beta")
    hook("Stop", "a", "alpha", last_assistant_message="Alpha is finished.")
    hook("Stop", "b", "beta", last_assistant_message="Beta is finished.")
    time.sleep(6)
    tap_ant("a")
    need(until(lambda s: s["mode"] == "reply" and carried(s, 0), 4), "alpha's reply didn't open and settle")
    for dx in (-60, -130, 40):
        s = drive("/drag", dx=dx, release=False)
        need(carried(s, dx), f"dragged to {dx}, the lines weren't there: {[round(l['cx'] - l['home']) for l in s['shown']]}")
    drive("/drag", dx=-40, speed=0)
    need(until(lambda s: carried(s, 0), 3), "let go short, the text didn't spring back")
    need(any("Alpha is finished" in p["text"] for p in state()["placed"]), "let go short, it moved to another reply")
    drive("/drag", dx=-260, speed=0)
    need(until(lambda s: any("Beta is finished" in p["text"] for p in s["placed"])), "carried far and let go, it didn't move to beta's")


