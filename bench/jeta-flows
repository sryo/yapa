def read_reply():
    hook("UserPromptSubmit", "a", "alpha"); hook("UserPromptSubmit", "b", "beta")
    hook("Stop", "a", "alpha", last_assistant_message="Alpha is finished and tested.")
    time.sleep(6)  # done only 5 s after the Stop
    home = ant(state(), "a")
    tap_ant("a")
    s = until(lambda s: s["mode"] == "reply")
    need(s and any("Alpha is finished" in p["text"] for p in s["placed"]), "tapping the ant didn't open its reply")
    s = until(lambda s: ant(s, "a")["act"] == "aside" and near_text(s, "a"))
    need(s, f"its ant didn't walk to the side of its text: {ant(state(), 'a')} {first_line(state())}")
    drive("/tap")
    need(until(bare, 3), "a tap didn't close the reply")
    s = until(lambda s: abs(ant(s, "a")["x"] - home["x"]) < 40 and abs(ant(s, "a")["y"] - home["y"]) < 40, 8)
    need(s, f"its ant didn't walk back home: {ant(state(), 'a')} vs {home}")


