    s = until(lambda s: s["mode"] == "reply" and carried_down(s, 0), 4)
    W, H = s["size"]
    need(s and s["pages"] and s["pages"][1] > 2, f"the long reply didn't open on several pages: {s and s['pages']}")
    last = s["pages"][1] - 1
    s = drive("/drag", dy=60, release=False)
    need(carried_down(s, rubber(60, H)), f"pulled down on the first page, it didn't follow the rubber band: "
         f"{[round(l['cy'] - l['homeY']) for l in s['shown']]} vs {round(rubber(60, H))}")
    drive("/drag", dy=60, speed=0)
    s = until(lambda s: carried_down(s, 0), 3)
    need(s and s["pages"][0] == 0, f"let go past the first page, it didn't spring back onto it: {state()['pages']}")
    s = drive("/drag", dy=-40, release=False)
    need(carried_down(s, -40), f"dragged up, the page didn't follow 1:1: {[round(l['cy'] - l['homeY']) for l in s['shown']]}")
    drive("/drag", dy=-30, speed=0)
    s = until(lambda s: carried_down(s, 0), 3)
    need(s and s["pages"][0] == 0, f"let go short, it turned the page: {state()['pages']}")
    drive("/drag", dy=-150, speed=0)
    need(until(lambda s: s["pages"][0] == 1 and carried_down(s, 0), 3), f"dragged far up, it didn't turn to page 2: {state()['pages']}")
    need(until(lambda s: ant(s, "a")["act"] == "aside" and near_text(s, "a"), 3),
         f"the page turned, its ant didn't stay beside the text: {ant(state(), 'a')} {first_line(state())}")
    for _ in range(last - 1):
        drive("/drag", dy=-150, speed=0)
        time.sleep(0.4)
    need(until(lambda s: s["pages"][0] == last and carried_down(s, 0), 3), f"it didn't reach the last page: {state()['pages']}")
    s = drive("/drag", dy=-120, release=False)
    need(carried_down(s, rubber(-120, H)), f"pulled up on the last page, it didn't follow the rubber band: "
         f"{[round(l['cy'] - l['homeY']) for l in s['shown']]} vs {round(rubber(-120, H))}")
    drive("/drag", dy=-120, speed=-900)
    s = until(lambda s: carried_down(s, 0), 3)
    need(s and s["pages"][0] == last, f"flicked past the last page, it didn't spring back onto it: {state()['pages']}")
    s = drive("/drag", dx=-120, release=False)
    need(carried(s, rubber(-120, W)), f"dragged sideways with only one reply, it didn't follow the rubber band: "
         f"{[round(l['cx'] - l['home']) for l in s['shown']]} vs {round(rubber(-120, W))}")
    drive("/drag", dx=-200, speed=-900)
    s = until(lambda s: carried(s, 0), 3)
    need(s and s["mode"] == "reply" and s["pages"][0] == last, f"swiped with only one reply, it didn't spring back: {state()['mode']}")


