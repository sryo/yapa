def launch():
    sim("terminate", "booted", BUNDLE, check=False)
    data = sim("get_app_container", "booted", BUNDLE, "data").strip()
    for f in ("sessions.json",):
        try: os.remove(os.path.join(data, "Documents", f))
        except FileNotFoundError: pass
    sim("spawn", "booted", "defaults", "delete", BUNDLE, check=False)
    sim("launch", "booted", BUNDLE, "-drive", str(DRIVE), "-che", f"127.0.0.1:{STUB}", "-yata", f"http://127.0.0.1:{STUB}/parts")
    for _ in range(60):
        try: state(); hook("SessionStart", "warm", "warm"); hook("SessionEnd", "warm", "warm"); return
        except Exception: time.sleep(0.2)
    raise SystemExit("the pad never answered its driver")


def main():
    if "Booted" not in sim("list", "devices", "booted"):
        raise SystemExit("jeta-flows needs a booted Simulator")
    app = subprocess.run([os.path.join(ROOT, "jeta/build-app"), "sim"], capture_output=True, text=True, cwd=os.path.join(ROOT, "jeta"))
    if app.returncode: raise SystemExit(app.stderr)
    sim("install", "booted", os.path.join(ROOT, "jeta", app.stdout.strip().splitlines()[-1]))
    sim("privacy", "booted", "grant", "microphone", BUNDLE, check=False)
    server = ThreadingHTTPServer(("127.0.0.1", STUB), Stub)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    only = [a for a in sys.argv[1:] if not a.startswith("-")]
    failed = []
    for name, flow in FLOWS.items():
        if only and not any(o in name for o in only): continue
        launch()
        try:
            flow(); why = ""
        except Fail as x: why = str(x)
        except Exception as x: why = f"{type(x).__name__}: {x}"
        if why: failed.append(name)
        if VERBOSE or why: print(("FAIL " if why else "ok   ") + name + (": " + why if why else ""), file=sys.stderr)
    sim("terminate", "booted", BUNDLE, check=False)
    ran = len([n for n in FLOWS if not only or any(o in n for o in only)])
    runs = os.path.join(os.environ.get("FIUM_HOME", os.path.expanduser("~/.fium")), "runs", "yapa")
    os.makedirs(runs, exist_ok=True)
    path = os.path.join(runs, f"flows-{int(time.time())}.json")
    commit = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True, cwd=ROOT).stdout.strip()
    dirty = bool(subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True, cwd=ROOT).stdout.strip())
    json.dump({"commit": commit, "dirty": dirty,
               "metrics": {"flows_failed": {"dir": "lower", "kind": "quality", "samples": [len(failed)]},
                           "flows_completed": {"dir": "higher", "kind": "quality", "samples": [ran - len(failed)]}},
               "limits": {"flows_failed": 0}, "failed": failed}, open(path, "w"))
    print(path)


main()
