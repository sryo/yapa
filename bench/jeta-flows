def two_permissions():
    """Two sessions each asking permission: answering one brings up the other, which answers its own hook."""
    hook("UserPromptSubmit", "a", "alpha"); hook("UserPromptSubmit", "b", "beta")
    ta = held("PermissionRequest", "a", "alpha", tool_name="Bash", tool_input={"command": "git push"})
    time.sleep(0.3)
    tb = held("PermissionRequest", "b", "beta", tool_name="Bash", tool_input={"command": "rm -rf build"})
    need(until(lambda s: s["asking"] and option(s, "Deny")), "no request showed")
    tap_option("Allow")
    time.sleep(0.5)
    first = ta if ta.result else tb
    need(first.result, "neither hook got the first answer")
    need(until(lambda s: s["asking"] and option(s, "Deny")), "the second request didn't come up after the first")
    tap_option("Deny")
    second = tb if first is ta else ta
    d = decision(second)
    need(d.get("behavior") == "deny", f"the second request's own hook didn't get Deny: {d}")
    need(decision(first).get("behavior") == "allow", "the first request's answer changed")
    need(until(lambda s: not s["asking"]), "a request stayed up after both were answered")


