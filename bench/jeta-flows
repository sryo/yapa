def rubber(x, d):
    """iOS's rubber band: how far the text goes for a pull of `x` points past the end of a screen `d` long."""
    k = 0.55 * abs(x) / d + 1
    return (1 - 1 / k) * d * (1 if x > 0 else -1)


def carried_down(s, dy):
    """Every line of the reply sits `dy` points below its place, give or take the drift, and the rest at theirs."""
    return s["shown"] and all(abs(l["cy"] - l["homeY"] - (dy if l["band"] else 0)) < 2 for l in s["shown"])


def pages_bounce():
    long = " ".join(f"Step {i} of the release went through and was checked twice." for i in range(1, 31))
    hook("UserPromptSubmit", "a", "alpha")
    hook("Stop", "a", "alpha", last_assistant_message=long)
