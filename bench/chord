#!/bin/sh
# Measures goal 2's chord reading on this Mac: misreads and misfired decisions per 1,000 replayed gestures, ms to lock a chord and µs of CPU per touch
# update, and prints the path of a K1 run file.
cd "$(dirname "$0")/.." || exit 1
out=$(swift run -q -c release --package-path pad chordbench) || exit 1
miss=$(echo "$out" | sed -n 1p | tr -d '[]'); fire=$(echo "$out" | sed -n 2p | tr -d '[]'); lock=$(echo "$out" | sed -n 3p | tr -d '[]'); us=$(echo "$out" | sed -n 4p | tr -d '[]')
runs="${FIUM_HOME:-$HOME/.fium}/runs/yapa"; mkdir -p "$runs"
file=$runs/chord-$(date +%s).json
cat > "$file" <<JSON
{"commit": "$(git rev-parse HEAD)", "dirty": $([ -n "$(git status --porcelain)" ] && echo true || echo false),
 "metrics": {"chord_misreads_per_1000": {"dir": "lower", "kind": "quality", "samples": [$miss]},
  "chord_misfires_per_1000": {"dir": "lower", "kind": "quality", "samples": [$fire]},
  "chord_lock_ms": {"dir": "lower", "kind": "time", "samples": [$lock]},
  "chord_update_us": {"dir": "lower", "kind": "time", "noisy": true, "samples": [$us]}},
 "limits": {}}
JSON
echo "$file"
