#!/bin/sh
# R4: the pad app builds with push-to-talk: it asks for the mic and the local network, browses for
# yapa-talk over Bonjour, and frames its POST the way the Mac's parser accepts.
cd "$(dirname "$0")/.." || exit 1
pad/build-app sim >/dev/null || exit 1
app=build/pad/sim/yapa.app
for k in NSMicrophoneUsageDescription NSLocalNetworkUsageDescription NSBonjourServices; do
  plutil -extract $k raw "$app/Info.plist" >/dev/null 2>&1 || { echo "FAIL: Info.plist lacks $k"; exit 1; }
done
plutil -extract NSBonjourServices json -o - "$app/Info.plist" | grep -q '_yapa-talk._tcp' || { echo "FAIL: Bonjour service not declared"; exit 1; }
grep -q 'bonjour(type: "_yapa-talk._tcp"' pad/App/Talk.swift || { echo "FAIL: app doesn't browse for _yapa-talk._tcp"; exit 1; }
grep -q 'POST \\(path) HTTP/1.1\\r\\nHost: yapa\\r\\nContent-Length: \\(body.count)\\r\\n' pad/App/Talk.swift || { echo "FAIL: Talk.swift POST framing changed; check it against mac Request"; exit 1; }
echo "ok r4 talk"
