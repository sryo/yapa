#!/bin/sh
# Every shell script in the repo parses: a stray quote fails here, not halfway through an install.
cd "$(dirname "$0")/.." || exit 1
for f in mac/install jeta/install jeta/build-app build-ios bench/*; do
  [ -f "$f" ] && head -1 "$f" | grep -q '^#!/bin/sh' || continue
  sh -n "$f" || { echo "shell: $f doesn't parse"; exit 1; }
done
