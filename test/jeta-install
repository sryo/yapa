#!/bin/sh
# jeta/install says the phone is probably locked when the app never starts (uiopen does nothing then), right away
# instead of after a minute of waiting for heartbeats; asks again when the first uiopen misses; and says connected
# when the app runs and the desktop answers.
cd "$(dirname "$0")/.." || exit 1
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT INT TERM
mkdir -p "$tmp/bin"
cat > "$tmp/bin/ssh" <<FAKE
#!/bin/sh
echo "\$*" >> "$tmp/asked"
while [ \$# -gt 1 ]; do shift; done
case "\$1" in
  *trollstorehelper*) exit 0 ;;
  *uiopen*) [ -f "$tmp/wakes" ] && touch "$tmp/running"; exit 0 ;;
  *"ps -A"*) [ -f "$tmp/running" ] && echo "/var/containers/Bundle/Application/X/jeta.app/jeta"; exit 0 ;;
  *tail*) [ -f "$tmp/running" ] && echo "heartbeats"; exit 0 ;;
esac
FAKE
printf '#!/bin/sh\n' > "$tmp/bin/scp"
printf '#!/bin/sh\n' > "$tmp/bin/sleep"
chmod +x "$tmp/bin/"*
install() { HOME="$tmp/home" YAPA_HOST= PATH="$tmp/bin:$PATH" jeta/install > "$tmp/out" 2>&1; }

# It goes to the phone `./ya install` saved, and with none saved says how to save one instead of guessing an address.
mkdir -p "$tmp/home"
install && { echo "jeta-install: went ahead with no phone saved:"; cat "$tmp/out"; exit 1; }
grep -q "ya install" "$tmp/out" || { echo "jeta-install: with no phone saved it didn't say to run ./ya install; it said:"; cat "$tmp/out"; exit 1; }
[ -e "$tmp/asked" ] && { echo "jeta-install: reached for a phone with none saved: $(cat "$tmp/asked")"; exit 1; }
mkdir -p "$tmp/home/.config/yapa" && echo root@10.9.8.7 > "$tmp/home/.config/yapa/host"

install && { echo "jeta-install: succeeded with the app not running:"; cat "$tmp/out"; exit 1; }
grep -q "root@10.9.8.7" "$tmp/asked" || { echo "jeta-install: didn't go to the saved phone: $(cat "$tmp/asked")"; exit 1; }
grep -v "root@10.9.8.7" "$tmp/asked" | grep -q . && { echo "jeta-install: went somewhere other than the saved phone: $(cat "$tmp/asked")"; exit 1; }
grep -qi "locked" "$tmp/out" || { echo "jeta-install: didn't say the phone may be locked; it said:"; cat "$tmp/out"; exit 1; }
grep -qi "heartbeats" "$tmp/out" && { echo "jeta-install: blamed heartbeats when the app never started:"; cat "$tmp/out"; exit 1; }

touch "$tmp/running"
install || { echo "jeta-install: failed with the app running and heartbeats:"; cat "$tmp/out"; exit 1; }
grep -q "connected" "$tmp/out" || { echo "jeta-install: didn't say connected; it said:"; cat "$tmp/out"; exit 1; }

rm "$tmp/running"; touch "$tmp/wakes"
install || { echo "jeta-install: gave up though asking uiopen again starts the app:"; cat "$tmp/out"; exit 1; }
