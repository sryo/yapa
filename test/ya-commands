#!/bin/sh
# R7: ./ya publishes a folder (ya site) and runs a Go service (ya service) on the phone with one command each,
# with no ssh to type: it remembers the phone from ./ya install, and says in plain words what went wrong.
# A fake ssh runs the phone's side here, under a temp dir standing in for /var/jb; launchctl, chown and the
# Mac's cloudflared are logged.
cd "$(dirname "$0")/.." || exit 1
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT INT TERM
mkdir -p "$tmp/bin" "$tmp/jb" "$tmp/build" "$tmp/conf"
for d in yata yapa-run caddy cloudflared hello other; do printf "fake $d" > "$tmp/build/$d"; done
cat > "$tmp/bin/ssh" <<FAKE
#!/bin/sh
[ -f "$tmp/down" ] && { echo "ssh: connect to host phone port 22: Operation timed out" >&2; exit 255; }
while [ \$# -gt 1 ]; do shift; done
YAPA_JB="$tmp/jb" PATH="$tmp/bin:\$PATH" sh -c "\$1"
FAKE
printf '#!/bin/sh\necho "launchctl $*" >> "%s/log"\n' "$tmp" > "$tmp/bin/launchctl"
printf '#!/bin/sh\necho "chown $*" >> "%s/log"\n' "$tmp" > "$tmp/bin/chown"
printf '#!/bin/sh\necho "cloudflared $*" >> "%s/log"\n' "$tmp" > "$tmp/bin/cloudflared"
chmod +x "$tmp/bin/"*
ya() { PATH="$tmp/bin:$PATH" YAPA_BUILD="$tmp/build" YAPA_CONFIG="$tmp/conf" YAPA_DOMAIN=example.com YAPA_HOST= ./ya "$@" > "$tmp/out" 2>&1; }
ok() { : > "$tmp/log"; ya "$@" || { echo "R7: ./ya $* failed:"; cat "$tmp/out"; exit 1; }; }
no() { : > "$tmp/log"; ya "$@" && { echo "R7: ./ya $* should have failed:"; cat "$tmp/out"; exit 1; }; [ -s "$tmp/log" ] && fail "./ya $* failed but still touched the phone or Cloudflare"; return 0; }
fail() { echo "R7: $*"; exit 1; }
says() { grep -qi -- "$1" "$tmp/out" || { echo "R7: $2; it said:"; cat "$tmp/out"; exit 1; }; }
jb=$tmp/jb; ld=$jb/Library/LaunchDaemons; etc=$jb/etc/yapa; bin=$jb/usr/libexec/yapa
mkdir -p "$tmp/My Site/css"; echo home > "$tmp/My Site/index.html"; echo body > "$tmp/My Site/css/a.css"

# Before ./ya install, ya doesn't know the phone, and says how to tell it.
no site "$tmp/My Site"; says "ya install" "a site before any install must say to run ./ya install"
ok install root@phone
[ "$(cat "$tmp/conf/host")" = root@phone ] || fail "./ya install doesn't remember the phone"
cp "$etc/Caddyfile" "$tmp/Caddyfile.before"

# A folder with no name goes under the main site, at its folder's name; nothing changes in Cloudflare or Caddy.
ok site "$tmp/My Site"
[ "$(cat "$jb/var/yapa/www/my-site/index.html")" = home ] && [ -f "$jb/var/yapa/www/my-site/css/a.css" ] || fail "the folder isn't at www/my-site"
says "https://yapa.example.com/my-site/" "ya site must print the public address"
grep -q cloudflared "$tmp/log" && fail "a site under the main address needs no new DNS name"
cmp -s "$etc/Caddyfile" "$tmp/Caddyfile.before" || fail "a site under the main address needs no Caddyfile change"

# With a name, it gets its own address: a Caddy block on the phone, a DNS name through the tunnel.
ok site "$tmp/My Site" blog
[ "$(cat "$jb/var/yapa/sites/blog/index.html")" = home ] || fail "the named site isn't in sites/blog"
grep -q '^http://blog.example.com:8080 {' "$etc/Caddyfile" || fail "no Caddyfile block for blog.example.com"
sed -n '/^http:\/\/blog.example.com:8080 {/,/^}/p' "$etc/Caddyfile" | grep -q 'bind 127.0.0.1' || fail "blog's Caddy block must listen on the phone only"
grep -q 'cloudflared tunnel route dns yapa blog.example.com' "$tmp/log" || fail "blog.example.com wasn't routed to the tunnel"
grep -q 'launchctl load .*com.sryo.yapa.caddy.plist' "$tmp/log" || fail "Caddy wasn't restarted to serve blog"
says "https://blog.example.com/" "ya site blog must print its address"
# Publishing again replaces the files and adds nothing twice.
rm "$tmp/My Site/css/a.css"; echo v2 > "$tmp/My Site/index.html"
ok site "$tmp/My Site" blog
[ "$(cat "$jb/var/yapa/sites/blog/index.html")" = v2 ] && [ ! -e "$jb/var/yapa/sites/blog/css/a.css" ] || fail "republishing didn't replace the old files"
[ "$(grep -c '^http://blog.example.com:8080 {' "$etc/Caddyfile")" -eq 1 ] || fail "republishing duplicated blog's Caddy block"

# Names that aren't ours or aren't web names are refused before anything changes.
no site "$tmp/My Site" www; says "www" "refusing www must say why"
no site "$tmp/My Site" yapa
no site "$tmp/My Site" "Blog!"; says "lowercase" "a bad name must say what a good one looks like"
no site "$tmp/nope"; says "no folder" "a missing folder must say so"

# A service: built, installed with its own launchd job and port, watched by yata.
no service missing; says "cmd/missing" "a service with no binary must say where its code goes"
no service caddy; says "caddy" "yapa's own daemons can't be replaced through ya service"
ok service hello
[ "$(cat "$bin/hello")" = "fake hello" ] && [ -x "$bin/hello" ] || fail "hello not installed executable"
p=$ld/com.sryo.yapa.hello.plist
[ "$(plutil -extract ProgramArguments.0 raw "$p")" = /var/jb/usr/libexec/yapa/yapa-run ] || fail "hello must start through yapa-run"
[ "$(plutil -extract ProgramArguments.2 raw "$p")" = /var/jb/usr/libexec/yapa/hello ] || fail "hello's plist must run hello"
[ "$(plutil -extract EnvironmentVariables.PORT raw "$p")" = 9000 ] || fail "the first service gets PORT 9000"
[ "$(plutil -extract EnvironmentVariables.GODEBUG raw "$p")" = netdns=cgo ] || fail "a service must resolve names through iOS"
[ "$(plutil -extract KeepAlive raw "$p")" = true ] || fail "launchd must keep hello alive"
grep -q "chown root:wheel .*com.sryo.yapa.hello.plist" "$tmp/log" || fail "hello's plist must be owned by root:wheel"
grep -q "launchctl load .*com.sryo.yapa.hello.plist" "$tmp/log" || fail "hello wasn't started"
grep -q '"name":"hello","check":"tcp:127.0.0.1:9000"' "$etc/services.json" || fail "yata doesn't watch hello"
grep -q "launchctl load .*com.sryo.yapa.yata.plist" "$tmp/log" || fail "yata wasn't restarted to read hello"
grep -q cloudflared "$tmp/log" && fail "a service with no name stays off the internet"
says "9000" "ya service must say where hello listens"
ok service other
grep -q '"name":"other","check":"tcp:127.0.0.1:9001"' "$etc/services.json" || fail "the second service gets the next port"
ok service hello
[ "$(grep -o '"name":"hello"' "$etc/services.json" | wc -l)" -eq 1 ] && grep -q '"tcp:127.0.0.1:9000"' "$etc/services.json" || fail "reinstalling hello must keep its one entry and port"
# With a name, a service gets its address the same way a site does.
ok service hello api
sed -n '/^http:\/\/api.example.com:8080 {/,/^}/p' "$etc/Caddyfile" | grep -q 'reverse_proxy 127.0.0.1:9000' || fail "api.example.com isn't sent to hello"
grep -q 'cloudflared tunnel route dns yapa api.example.com' "$tmp/log" || fail "api.example.com wasn't routed to the tunnel"
says "https://api.example.com/" "ya service hello api must print its address"
# One address, one thing.
ya service other blog && fail "blog is a site; ya service other blog must refuse it"
says "blog" "a taken name must say which"
grep -q "reverse_proxy 127.0.0.1:9001" "$etc/Caddyfile" && fail "a taken name still changed the Caddyfile"

# ./ya install keeps the services it didn't ship, and leaves them running.
ok install
[ -x "$bin/hello" ] && [ -f "$ld/com.sryo.yapa.hello.plist" ] || fail "install removed a service added with ya service"
grep -q "unload .*com.sryo.yapa.hello.plist" "$tmp/log" && fail "install stopped hello"
grep -q '"name":"hello"' "$etc/services.json" || fail "install dropped hello from services.json"

# A phone that can't be reached gets a plain answer, not ssh's.
touch "$tmp/down"; : > "$tmp/log"
ya site "$tmp/My Site" && fail "ya site worked with the phone unreachable"
says "can't reach the phone" "an unreachable phone must be said plainly"
says "Dopamine" "an unreachable phone must say what to check"
grep -q "Operation timed out" "$tmp/out" && fail "ssh's own error leaked through"
exit 0
