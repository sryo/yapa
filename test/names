#!/bin/sh
# The project's names: yata watches the phone's services (plain ASCII, no accent, in every file and command),
# jeta is the face app with JetaKit inside, che is the Mac side of push-to-talk. Old names must not linger.
cd "$(dirname "$0")/.." || exit 1
fail() { echo "names: $1"; exit 1; }
[ -d cmd/yata ] || fail "the watcher daemon lives in cmd/yata"
[ -f launchd/com.sryo.yapa.yata.plist ] || fail "launchd/com.sryo.yapa.yata.plist is yata's launchd job"
[ "$(plutil -extract Label raw launchd/com.sryo.yapa.yata.plist)" = com.sryo.yapa.yata ] || fail "yata's launchd label"
[ -f jeta/Package.swift ] && grep -q '"JetaKit"' jeta/Package.swift || fail "jeta/ holds the app and its JetaKit library"
[ "$(plutil -extract CFBundleDisplayName raw jeta/App/Info.plist)" = jeta ] || fail "the app shows as jeta on the phone"
[ -d mac/Sources/che ] || fail "push-to-talk's Mac agent is built as che"
[ -f mac/com.sryo.yapa.che.plist ] || fail "mac/com.sryo.yapa.che.plist is che's launch agent"
[ "$(plutil -extract Label raw mac/com.sryo.yapa.che.plist)" = com.sryo.yapa.che ] || fail "che's launch agent label"
left=$(git grep -nIE 'yapad|FaceKit|package-path pad|build/pad|yatá|yapa-talk|YAPA_TALK' -- . ':!test/names' ':!README.md' ':!GOALS.md' | head -5)
[ -z "$left" ] || fail "old names remain:
$left"
# Layout: bench/ holds measurements only; tests live in test/, named for what they check; run files stay out of git.
[ -z "$(git ls-files 'bench/test-*' 'bench/runs/*' bench/baseline.json)" ] || fail "bench/ holds only measurements: tests go in test/, runs in ~/.fium"
while read -r c; do f=${c%% *}; [ -e "$f" ] || [ "$f" = go ] || [ "$f" = swift ] || fail "bench/checks runs $f, which doesn't exist"; done < bench/checks
# Benches are named for the project they measure: jeta-*, che, yata; size is the whole repo.
for old in face chord notice pad ptt health; do [ -e "bench/$old" ] && fail "bench/$old is named for the project now (see AGENTS.md)"; done
