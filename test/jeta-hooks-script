#!/bin/sh
# R1: `jeta/hooks on` puts hooks in Claude Code's settings that curl the phone directly, with a 1 s connect timeout,
# beside the user's own, keeping the original once; `off` takes exactly its own out.
# The phone is the address ./ya install saved, since iOS answers its .local name only some of the time; with none
# saved, the name.
cd "$(dirname "$0")/.." || exit 1
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
s="$tmp/settings.json"
export YAPA_HOST_FILE="$tmp/no-host"
cat > "$s" <<EOF
{
  "model": "opus",
  "hooks": {
    "Stop": [{"hooks": [{"type": "command", "command": "say done"}]}]
  }
}
EOF
cp "$s" "$tmp/orig"
JETA_SETTINGS="$s" jeta/hooks on >/dev/null || { echo "FAIL: jeta/hooks on"; exit 1; }
cp "$s" "$tmp/on"
JETA_SETTINGS="$s" jeta/hooks on >/dev/null && cmp -s "$s" "$tmp/on" || { echo "FAIL: on twice changed the settings again"; exit 1; }
cmp -s "$s.before-yapa" "$tmp/orig" || { echo "FAIL: on kept no exact copy of the original"; exit 1; }
[ "$(JETA_SETTINGS="$s" jeta/hooks)" = "on" ] || { echo "FAIL: jeta/hooks doesn't say on"; exit 1; }
/usr/bin/python3 -I - "$s" <<'EOF' || exit 1
import json, sys
h = json.load(open(sys.argv[1]))["hooks"]
def fail(m): print("FAIL:", m); sys.exit(1)
cmds = [(e, x) for e, gs in h.items() for g in gs for x in g["hooks"]]
ours = [(e, x) for e, x in cmds if "claude-yapa.local:8079/hook" in x["command"]]
if len(ours) != 10: fail(f"{len(ours)} hooks to the phone, want 10")
if not any(x["command"] == "say done" for _, x in cmds): fail("the user's own Stop hook is gone")
for e, x in ours:
    if "--connect-timeout 1" not in x["command"] or not x["command"].endswith("|| true # jeta"): fail(f"{e}: {x['command']}")
    if (e == "PermissionRequest") != (x.get("async") is None): fail(f"{e}: only the permission hook waits")
    if e == "PermissionRequest" and x.get("timeout") != 600: fail("the permission hook should wait up to 10 min")
EOF
JETA_SETTINGS="$s" jeta/hooks on 10.0.0.7 >/dev/null && grep -q '10.0.0.7:8079/hook' "$s" && ! grep -q claude-yapa.local "$s" \
  || { echo "FAIL: on <host> should point the hooks at that host instead"; exit 1; }
echo root@192.168.1.8 > "$tmp/host"
YAPA_HOST_FILE="$tmp/host" JETA_SETTINGS="$s" jeta/hooks on >/dev/null && grep -q '"curl .*192.168.1.8:8079/hook' "$s" && ! grep -q 10.0.0.7 "$s" \
  || { echo "FAIL: on with no host should use the phone ./ya install saved"; exit 1; }
JETA_SETTINGS="$s" jeta/hooks off >/dev/null || { echo "FAIL: jeta/hooks off"; exit 1; }
/usr/bin/python3 -I -c '
import json, sys
got, want = json.load(open(sys.argv[1])), json.load(open(sys.argv[2]))
sys.exit(got != want)' "$s" "$tmp/orig" || { echo "FAIL: off didn't give back the user's settings:"; cat "$s"; exit 1; }
printf 'not json' > "$s"
JETA_SETTINGS="$s" jeta/hooks on >/dev/null 2>&1 && { echo "FAIL: on overwrote settings that aren't JSON"; exit 1; }
[ "$(cat "$s")" = "not json" ] || { echo "FAIL: settings that aren't JSON were changed"; exit 1; }
echo "ok jeta hooks script"
