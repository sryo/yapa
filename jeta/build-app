#!/bin/sh
# Builds the jeta app without an Xcode project: build-app sim -> build/jeta/sim/jeta.app (ad-hoc signed),
# build-app device -> build/jeta/jeta.ipa for TrollStore (signed with ldid).
set -e
cd "$(dirname "$0")"
out=../build/jeta
case "${1:-sim}" in
  sim) sdk=iphonesimulator; target=arm64-apple-ios15.0-simulator; app=$out/sim/jeta.app ;;
  device) sdk=iphoneos; target=arm64-apple-ios15.0; app=$out/device/Payload/jeta.app ;;
  *) echo "usage: build-app [sim|device]"; exit 1 ;;
esac
rm -rf "$app" && mkdir -p "$app"
xcrun --sdk $sdk swiftc -O -target $target -sdk "$(xcrun --sdk $sdk --show-sdk-path)" \
  -o "$app/jeta" Sources/JetaKit/*.swift Sources/BuddyKit/*.swift App/*.swift
cp App/Info.plist "$app/"
if [ "$1" = device ]; then
  ldid -S "$app/jeta"
  (cd $out/device && rm -f ../jeta.ipa && zip -qr ../jeta.ipa Payload)
  ls -l $out/jeta.ipa
else
  codesign -s - "$app" 2>/dev/null
  echo "$app"
fi
