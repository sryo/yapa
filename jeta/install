#!/bin/sh
# Installs build/jeta/jeta.ipa on the phone over SSH (TrollStore), launches it, and waits for the Claude desktop app to reconnect.
# Restarting bluetoothd drops the old link; otherwise the desktop keeps a dead connection to the previous app and never reconnects.
set -e
cd "$(dirname "$0")/.."
host=${YAPA_HOST:-root@192.168.1.8}
log=/var/mobile/Containers/Data/Application/*/Documents/buddy.log
scp -q build/jeta/jeta.ipa "$host:/var/mobile/jeta.ipa"
ssh "$host" "killall jeta 2>/dev/null; \$(ls /var/containers/Bundle/Application/*/TrollStore.app/trollstorehelper) install /var/mobile/jeta.ipa >/dev/null 2>&1 && uiopen --bundleid com.sryo.yapa && sleep 2 && killall -9 bluetoothd"
# uiopen does nothing while the phone is locked or asleep, and still succeeds.
i=0
until ssh "$host" "ps -A -o comm" | grep -q 'jeta.app/jeta$'; do
  i=$((i+1)); [ $i -gt 5 ] && { echo "installed, but jeta didn't start: is the phone locked? Unlock it and run jeta/install again"; exit 1; }
  sleep 1
done
i=0
until ssh "$host" "tail -1 $log" | grep -q heartbeats; do
  i=$((i+1)); [ $i -gt 30 ] && { echo "installed, but no heartbeats from the desktop after 60 s: open Developer → Open Hardware Buddy in Claude and connect Claude-yapa"; exit 1; }
  sleep 2
done
echo "installed; the desktop is connected"
